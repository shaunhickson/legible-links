{
  "manifest_version": 3,
  "name": "Legible Links",
  "version": "0.9.0",
  "description": "Turns raw URLs in link text into readable titles, and always shows where the link goes.",
  "homepage_url": "https://github.com/shaunhickson/legible-links",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://youtube-replacer-backend-542312799814.us-east1.run.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "assets/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["assets/content.js"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
